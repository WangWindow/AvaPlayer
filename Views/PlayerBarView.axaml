<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaPlayer.ViewModels"
             xmlns:fi="using:FluentIcons.Avalonia"
             x:Name="Root"
             x:Class="AvaPlayer.Views.PlayerBarView"
             x:DataType="vm:PlayerBarViewModel">
  <Grid Margin="56,0,56,0">
    <Grid x:Name="PlaybackContent"
          Classes="player-stage"
          Classes.hidden="{Binding IsSettingsVisible}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Cover art -->
      <Border Grid.Row="1"
              Width="{Binding CoverSize}"
              Height="{Binding CoverSize}"
              HorizontalAlignment="Center"
              CornerRadius="18"
              ClipToBounds="True"
              BoxShadow="0 14 40 0 #70000000">
        <Grid>
          <Border Background="#20FFFFFF"
                  IsVisible="{Binding ShowAlbumArtPlaceholder}" />
          <fi:FluentIcon Icon="MusicNote2"
                         FontSize="72"
                         Foreground="#60FFFFFF"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsVisible="{Binding ShowAlbumArtPlaceholder}" />
          <Image Source="{Binding AlbumArtBitmap}"
                 Stretch="UniformToFill"
                 IsVisible="{Binding HasAlbumArt}" />
        </Grid>
      </Border>

      <!-- Title & Artist -->
      <StackPanel Grid.Row="2"
                  Spacing="8"
                  HorizontalAlignment="Center"
                  MaxWidth="400"
                  Margin="0,24,0,0">
        <TextBlock Text="{Binding TitleDisplay}"
                   Classes="player-title"
                   FontSize="22"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding ArtistDisplay}"
                   Classes="player-subtitle"
                   FontSize="13"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- Progress bar -->
      <Grid Grid.Row="3"
            MaxWidth="500"
            HorizontalAlignment="Stretch"
            ColumnDefinitions="Auto,*,Auto"
            Margin="0,16,0,0">
        <TextBlock Grid.Column="0"
                   Text="{Binding PositionText}"
                   Classes="player-time"
                   FontSize="12"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center" />
        <Slider x:Name="ProgressSlider"
                Grid.Column="1"
                Classes="white"
                Minimum="0"
                Maximum="{Binding Duration}"
                Value="{Binding Position, Mode=TwoWay}" />
        <TextBlock Grid.Column="2"
                   Text="{Binding DurationText}"
                   Classes="player-time"
                   FontSize="12"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center" />
      </Grid>

      <!-- Playback controls -->
      <Grid Grid.Row="4"
            HorizontalAlignment="Center"
            Margin="0,12,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="10">
          <Button Classes="ghost"
                  Width="40" Height="40"
                  ToolTip.Tip="{Binding PlaybackModeTooltip}"
                  Command="{Binding TogglePlaybackModeCommand}">
            <fi:FluentIcon Icon="{Binding PlaybackModeIcon}" FontSize="18" />
          </Button>
          <Button Classes="ghost"
                  Width="40" Height="40"
                  ToolTip.Tip="上一首"
                  Command="{Binding PreviousCommand}">
            <fi:FluentIcon Icon="Previous" FontSize="18" />
          </Button>
          <Button Classes="ghost-large"
                  ToolTip.Tip="播放 / 暂停"
                  Command="{Binding PlayPauseCommand}">
            <fi:FluentIcon Icon="{Binding PlayPauseIcon}" FontSize="24" />
          </Button>
          <Button Classes="ghost"
                  Width="40" Height="40"
                  ToolTip.Tip="下一首"
                  Command="{Binding NextCommand}">
            <fi:FluentIcon Icon="Next" FontSize="18" />
          </Button>
          <Button x:Name="VolumeButton"
                  Classes="ghost volume-toggle"
                  Width="40" Height="40"
                  ToolTip.Tip="音量"
                  Click="OnVolumeButtonClick">
            <fi:FluentIcon Icon="{Binding VolumeIcon}" FontSize="18" />
          </Button>
        </StackPanel>

        <Border x:Name="VolumeInlinePanel"
                Grid.Row="1"
                Classes="volume-inline-host"
                HorizontalAlignment="Center"
                ClipToBounds="True"
                IsHitTestVisible="False">
          <Border Classes="volume-inline-surface"
                  Width="292" Margin="0,10,0,0"
                  HorizontalAlignment="Center">
            <Grid Height="24"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14"
                  VerticalAlignment="Center">
              <Grid Width="18"
                    Height="24"
                    VerticalAlignment="Center">
                <fi:FluentIcon Icon="{Binding VolumeIcon}"
                               FontSize="16"
                               Foreground="#F2FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
              </Grid>
              <Slider Grid.Column="1"
                      Classes="volume-slider"
                      Orientation="Horizontal"
                      Minimum="0" Maximum="100"
                      Height="24"
                      VerticalAlignment="Center"
                      Value="{Binding Volume, Mode=TwoWay}" />
              <Grid Grid.Column="2"
                    MinWidth="38"
                    Height="24"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding VolumeText}"
                           Classes="volume-text"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />
              </Grid>
            </Grid>
          </Border>
        </Border>
      </Grid>
    </Grid>

  </Grid>
</UserControl>
