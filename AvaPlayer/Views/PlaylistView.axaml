<UserControl x:Class="AvaPlayer.Views.PlaylistView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:models="using:AvaPlayer.Models"
             xmlns:vm="using:AvaPlayer.ViewModels"
             x:Name="Root"
             x:DataType="vm:PlaylistViewModel">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#30FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#18000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
      <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Margin="16,0,16,16" RowDefinitions="Auto,Auto,*,Auto">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
      <ComboBox Grid.Column="0"
                MinWidth="0"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="选择歌单"
                IsEnabled="{Binding !IsScanning}"
                IsVisible="{Binding ShowPlaylistSelector}"
                ItemsSource="{Binding Playlists}"
                SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}"
                ToolTip.Tip="选择歌单">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="models:PlaylistInfo">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="playlist-subtitle" Text="{Binding DisplayTrackCount}" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBox Grid.Column="0"
               AutomationProperties.Name="歌单名称"
               IsVisible="{Binding IsRenamingPlaylist}"
               PlaceholderText="歌单名称"
               Text="{Binding EditingPlaylistName, Mode=TwoWay}" />
      <Button Grid.Column="1"
              AutomationProperties.Name="添加歌单"
              Classes="ghost"
              Command="{Binding AddPlaylistCommand}"
              IsEnabled="{Binding !IsScanning}"
              ToolTip.Tip="添加歌单（选择一个音乐文件夹）">
        <fi:FluentIcon FontSize="16" Icon="FolderAdd" />
      </Button>
      <Button Grid.Column="2"
              AutomationProperties.Name="重命名歌单"
              Classes="ghost"
              Command="{Binding BeginRenamePlaylistCommand}"
              IsEnabled="{Binding CanManagePlaylist}"
              IsVisible="{Binding ShowPlaylistSelector}"
              ToolTip.Tip="重命名歌单">
        <fi:FluentIcon FontSize="16" Icon="Edit" />
      </Button>
      <Button Grid.Column="3"
              AutomationProperties.Name="删除歌单"
              Classes="ghost"
              Command="{Binding DeletePlaylistCommand}"
              IsEnabled="{Binding CanManagePlaylist}"
              IsVisible="{Binding ShowPlaylistSelector}"
              ToolTip.Tip="删除当前歌单（仅移除索引，不删除磁盘文件）">
        <fi:FluentIcon FontSize="16" Icon="Delete" />
      </Button>
      <Button Grid.Column="2"
              AutomationProperties.Name="确认重命名"
              Classes="ghost"
              Command="{Binding ConfirmRenamePlaylistCommand}"
              IsVisible="{Binding IsRenamingPlaylist}"
              ToolTip.Tip="确认重命名">
        <fi:FluentIcon FontSize="16" Icon="Checkmark" />
      </Button>
    </Grid>
    <Grid x:Name="LibraryTools"
          Grid.Row="1"
          Margin="0,10,0,0"
          ColumnDefinitions="*,36,36"
          ColumnSpacing="6">
      <Border Padding="10,0"
              Classes="playlist-search-bar"
              IsVisible="{Binding ShowNormalToolbar}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
          <fi:FluentIcon VerticalAlignment="Center"
                         Classes="playlist-search-icon"
                         FontSize="14"
                         Icon="Search" />
          <TextBox Grid.Column="1"
                   AutomationProperties.Name="搜索当前播放列表"
                   Background="Transparent"
                   BorderThickness="0"
                   PlaceholderText="搜索当前播放列表"
                   Text="{Binding SearchText, Mode=TwoWay}" />
          <Button Grid.Column="2"
                  Width="24"
                  Height="24"
                  Padding="0"
                  AutomationProperties.Name="清除搜索"
                  Classes="ghost"
                  Command="{Binding ClearSearchCommand}"
                  IsVisible="{Binding ShowClearSearch}"
                  ToolTip.Tip="清除搜索">
            <fi:FluentIcon FontSize="12" Icon="Dismiss" />
          </Button>
        </Grid>
      </Border>
      <Grid ColumnDefinitions="*,36,36"
            ColumnSpacing="4"
            IsVisible="{Binding ShowEditToolbar}">
        <TextBlock VerticalAlignment="Center"
                   Classes="playlist-toolbar-label"
                   FontSize="12"
                   Text="{Binding EditSelectionText}" />
        <Button Grid.Column="1"
                AutomationProperties.Name="移除选中歌曲"
                Classes="ghost"
                Command="{Binding RemoveSelectedCommand}"
                IsEnabled="{Binding CanRemoveSelected}"
                ToolTip.Tip="移除选中歌曲">
          <fi:FluentIcon FontSize="16" Icon="Delete" />
        </Button>
        <Button Grid.Column="2"
                AutomationProperties.Name="结束选择"
                Classes="ghost"
                Command="{Binding CancelEditCommand}"
                ToolTip.Tip="结束选择">
          <fi:FluentIcon FontSize="16" Icon="Checkmark" />
        </Button>
      </Grid>
      <ToggleButton x:Name="SubfoldersToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    Padding="8"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.Name="包含子文件夹"
                    IsChecked="{Binding IncludeSubfolders, Mode=TwoWay}"
                    IsEnabled="{Binding !IsScanning}"
                    ToolTip.Tip="包含子文件夹">
        <fi:FluentIcon FontSize="18" Icon="TextBulletListTree" />
      </ToggleButton>
      <Button x:Name="RescanButton"
              Grid.Column="2"
              AutomationProperties.Name="重新扫描"
              Classes="ghost"
              Command="{Binding RescanPlaylistCommand}"
              IsEnabled="{Binding HasSelectedPlaylist}"
              IsVisible="{Binding !IsScanning}"
              ToolTip.Tip="重新扫描当前文件夹">
        <fi:FluentIcon FontSize="18" Icon="ArrowClockwise" />
      </Button>
      <Button Grid.Column="2"
              AutomationProperties.Name="取消扫描"
              Classes="ghost"
              Command="{Binding CancelScanCommand}"
              IsVisible="{Binding IsScanning}"
              ToolTip.Tip="取消扫描">
        <fi:FluentIcon FontSize="18" Icon="Dismiss" />
      </Button>
    </Grid>
    <TextBlock Grid.Row="3"
               Classes="playlist-status-label"
               IsVisible="{Binding HasScanStatus}"
               Text="{Binding ScanStatus}"
               TextTrimming="CharacterEllipsis"
               ToolTip.Tip="{Binding ScanStatus}" />
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsVisible="{Binding ShowEmptyState}"
                  Spacing="12">
        <fi:FluentIcon HorizontalAlignment="Center"
                       Classes="playlist-empty-icon"
                       FontSize="44"
                       Icon="MusicNote2" />
        <TextBlock HorizontalAlignment="Center"
                   Classes="playlist-empty-text"
                   Text="{Binding EmptyStateText}" />
      </StackPanel>
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsVisible="{Binding ShowSearchEmptyState}"
                  Spacing="12">
        <fi:FluentIcon HorizontalAlignment="Center"
                       Classes="playlist-empty-icon"
                       FontSize="40"
                       Icon="Search" />
        <TextBlock HorizontalAlignment="Center"
                   Classes="playlist-empty-text"
                   Text="{Binding SearchEmptyStateText}" />
      </StackPanel>
      <ListBox x:Name="TrackList"
               Classes="playlist-list"
               IsVisible="{Binding HasVisibleTracks}"
               ItemsSource="{Binding VisibleTracks}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TrackItemViewModel">
            <Button Classes="playlist-item"
                    Classes.current="{Binding IsCurrent}"
                    Command="{Binding #Root((vm:PlaylistViewModel)DataContext).SelectTrackCommand}"
                    CommandParameter="{Binding}">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Command="{Binding #Root((vm:PlaylistViewModel)DataContext).SelectTrackCommand}"
                            CommandParameter="{Binding}"
                            Header="播放" />
                  <MenuItem Command="{Binding #Root((vm:PlaylistViewModel)DataContext).RemoveTrackCommand}"
                            CommandParameter="{Binding}"
                            Header="从歌单移除" />
                  <Separator />
                  <MenuItem Command="{Binding #Root((vm:PlaylistViewModel)DataContext).BeginEditCommand}" Header="选择多首歌曲" />
                </ContextMenu>
              </Button.ContextMenu>
              <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="10">
                <Grid Grid.Column="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                  <CheckBox IsChecked="{Binding IsSelectedForRemoval, Mode=TwoWay}" IsVisible="{Binding #Root((vm:PlaylistViewModel)DataContext).ShowEditToolbar}" />
                  <Grid IsVisible="{Binding #Root((vm:PlaylistViewModel)DataContext).ShowNormalToolbar}">
                    <fi:FluentIcon FontSize="14"
                                   Icon="Play"
                                   IsVisible="{Binding ShowCurrentGlyph}" />
                    <fi:FluentIcon FontSize="16"
                                   Icon="MusicNote2"
                                   IsVisible="{Binding ShowIdleGlyph}"
                                   Opacity="0.6" />
                  </Grid>
                </Grid>
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Spacing="3">
                  <TextBlock Classes="playlist-title"
                             Text="{Binding Title}"
                             TextAlignment="Left"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="playlist-subtitle"
                             Text="{Binding Artist}"
                             TextAlignment="Left"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Classes="playlist-duration"
                           Text="{Binding DurationText}"
                           TextAlignment="Right" />
              </Grid>
            </Button>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
