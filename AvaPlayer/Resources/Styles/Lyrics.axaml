<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fi="using:FluentIcons.Avalonia">
  <Style Selector="Button.lyric-line-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MaxWidth" Value="520" />
    <Setter Property="Transitions">
      <Transitions>
        <ThicknessTransition Property="Padding" Duration="0:0:0.22" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.lyric-line-button:pointerover">
    <Setter Property="Background" Value="{DynamicResource SearchBackgroundBrush}" />
  </Style>
  <Style Selector="Button.lyric-line-button:pressed">
    <Setter Property="Background" Value="{DynamicResource LyricLineButtonPressedBackgroundBrush}" />
  </Style>
  <Style Selector="Button.lyric-line-button.near">
    <Setter Property="Padding" Value="18,12" />
  </Style>
  <Style Selector="Button.lyric-line-button.active">
    <Setter Property="Background" Value="{DynamicResource LyricActiveBackgroundBrush}" />
    <Setter Property="Padding" Value="18,14" />
  </Style>
  <Style Selector="TextBlock.lyric-line">
    <Setter Property="Foreground" Value="{DynamicResource PlayerForegroundBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.26" />
        <ThicknessTransition Property="Margin" Duration="0:0:0.24" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBlock.lyric-line.near">
    <Setter Property="Margin" Value="0,10" />
  </Style>
  <Style Selector="TextBlock.lyric-line.active">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,14" />
  </Style>
  <Style Selector="TextBlock.lyrics-status">
    <Setter Property="Foreground" Value="{DynamicResource LyricsStatusForegroundBrush}" />
  </Style>
  <Style Selector="TextBlock.lyrics-empty">
    <Setter Property="Foreground" Value="{DynamicResource LyricsEmptyForegroundBrush}" />
  </Style>
</Styles>
