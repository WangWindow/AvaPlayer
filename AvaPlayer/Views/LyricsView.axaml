<UserControl x:Class="AvaPlayer.Views.LyricsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaPlayer.ViewModels"
             x:Name="Root"
             x:DataType="vm:LyricsViewModel">
  <Grid Margin="24,32">
    <TextBlock HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Classes="lyrics-status"
               FontSize="14"
               IsVisible="{Binding IsLoading}"
               Text="加载歌词中..." />
    <TextBlock HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Classes="lyrics-empty"
               FontSize="14"
               IsVisible="{Binding ShowEmptyState}"
               Text="暂无歌词" />
    <ScrollViewer x:Name="LyricsScroller"
                  HorizontalScrollBarVisibility="Disabled"
                  IsVisible="{Binding HasLyrics}"
                  VerticalScrollBarVisibility="Hidden">
      <StackPanel>
        <Border x:Name="TopSpacer" />
        <ItemsControl x:Name="LyricsItems"
                      MaxWidth="560"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Lines}">
          <ItemsControl.Styles>
            <Style Selector="ContentPresenter">
              <Setter Property="HorizontalAlignment" Value="Stretch" />
              <Setter Property="ClipToBounds" Value="False" />
            </Style>
          </ItemsControl.Styles>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LyricLineViewModel">
              <Button HorizontalAlignment="Stretch"
                      Classes="lyric-line-button"
                      Classes.active="{Binding IsCurrent}"
                      Classes.near="{Binding IsNearCurrent}"
                      ClipToBounds="False"
                      Command="{Binding #Root((vm:LyricsViewModel)DataContext).SeekToLineCommand}"
                      CommandParameter="{Binding}">
                <TextBlock Classes="lyric-line"
                           Classes.active="{Binding IsCurrent}"
                           Classes.near="{Binding IsNearCurrent}"
                           FontSize="{Binding DisplayFontSize}"
                           Opacity="{Binding DisplayOpacity}"
                           Text="{Binding Text}" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border x:Name="BottomSpacer" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
