<UserControl x:Class="AvaPlayer.Views.PlayerBarView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:views="using:AvaPlayer.Views"
             xmlns:vm="using:AvaPlayer.ViewModels"
             x:Name="Root"
             x:DataType="vm:PlayerBarViewModel">
  <Grid x:Name="PlaybackRoot" Margin="24,16">
    <Grid x:Name="PlaybackContent">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <!--  Cover art  -->
      <Border x:Name="CoverBorder"
              Grid.Row="1"
              Width="{Binding CoverSize}"
              Height="{Binding CoverSize}"
              HorizontalAlignment="Center"
              BoxShadow="0 12 36 0 #50000000"
              ClipToBounds="True"
              CornerRadius="18">
        <Grid>
          <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" IsVisible="{Binding ShowAlbumArtPlaceholder}" />
          <fi:FluentIcon HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="72"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                         Icon="MusicNote2"
                         IsVisible="{Binding ShowAlbumArtPlaceholder}" />
          <Image IsVisible="{Binding HasAlbumArt}"
                 Source="{Binding AlbumArtBitmap}"
                 Stretch="UniformToFill" />
        </Grid>
      </Border>
      <!--  Title & Artist  -->
      <StackPanel x:Name="TrackDetails"
                  Grid.Row="2"
                  MaxWidth="400"
                  Margin="0,24,0,0"
                  HorizontalAlignment="Center"
                  Spacing="8">
        <TextBlock x:Name="TrackTitle"
                   Classes="player-title"
                   FontSize="22"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Text="{Binding TitleDisplay}"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="ArtistText"
                   Classes="player-subtitle"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Text="{Binding ArtistDisplay}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
      <!--  Progress bar  -->
      <Grid x:Name="ProgressGrid"
            Grid.Row="3"
            MaxWidth="360"
            Margin="0,16,0,0"
            HorizontalAlignment="Stretch"
            ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center"
                   Classes="player-time"
                   FontSize="12"
                   Text="{Binding PositionText}" />
        <Slider x:Name="ProgressSlider"
                Grid.Column="1"
                AutomationProperties.Name="播放进度"
                Maximum="{Binding Duration}"
                Minimum="0"
                Value="{Binding Position, Mode=TwoWay}" />
        <TextBlock Grid.Column="2"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   Classes="player-time"
                   FontSize="12"
                   Text="{Binding DurationText}" />
      </Grid>
      <!--  Playback controls  -->
      <Grid x:Name="ControlGrid"
            Grid.Row="4"
            Width="292"
            Margin="0,12,0,0"
            HorizontalAlignment="Center">
        <StackPanel HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
          <Button Width="40"
                  Height="40"
                  AutomationProperties.Name="{Binding PlaybackModeTooltip}"
                  Classes="ghost"
                  Command="{Binding TogglePlaybackModeCommand}"
                  ToolTip.Tip="{Binding PlaybackModeTooltip}">
            <fi:FluentIcon FontSize="18" Icon="{Binding PlaybackModeIcon}" />
          </Button>
          <Button Width="40"
                  Height="40"
                  AutomationProperties.Name="上一首"
                  Classes="ghost"
                  Command="{Binding PreviousCommand}"
                  ToolTip.Tip="上一首（Ctrl+←）">
            <fi:FluentIcon FontSize="18" Icon="Previous" />
          </Button>
          <Button AutomationProperties.Name="播放 / 暂停"
                  Classes="ghost-large"
                  Command="{Binding PlayPauseCommand}"
                  ToolTip.Tip="播放 / 暂停（Ctrl+P）">
            <fi:FluentIcon FontSize="24" Icon="{Binding PlayPauseIcon}" />
          </Button>
          <Button Width="40"
                  Height="40"
                  AutomationProperties.Name="下一首"
                  Classes="ghost"
                  Command="{Binding NextCommand}"
                  ToolTip.Tip="下一首（Ctrl+→）">
            <fi:FluentIcon FontSize="18" Icon="Next" />
          </Button>
          <Button x:Name="VolumeButton"
                  Width="40"
                  Height="40"
                  AutomationProperties.Name="音量"
                  Classes="ghost"
                  Click="OnVolumeButtonClick"
                  ToolTip.Tip="音量">
            <fi:FluentIcon FontSize="18" Icon="{Binding VolumeIcon}" />
          </Button>
        </StackPanel>
      </Grid>
      <views:RevealPresenter x:Name="VolumeInlinePanel"
                             Grid.Row="5"
                             Width="292"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             HorizontalContentAlignment="Stretch"
                             Classes="volume-inline-host"
                             ClipToBounds="True"
                             TransitionDuration="0:0:0.22">
        <Border Margin="0,4"
                Padding="12,0"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="8">
          <Grid VerticalAlignment="Center"
                ColumnDefinitions="38,*,38"
                ColumnSpacing="14">
            <fi:FluentIcon HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Icon="{Binding VolumeIcon}" />
            <Slider x:Name="VolumeSlider"
                    Grid.Column="1"
                    AutomationProperties.Name="音量"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding Volume, Mode=TwoWay}" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Classes="volume-text"
                       FontSize="12"
                       Text="{Binding VolumeText}"
                       TextAlignment="Center" />
          </Grid>
        </Border>
      </views:RevealPresenter>
    </Grid>
  </Grid>
</UserControl>
