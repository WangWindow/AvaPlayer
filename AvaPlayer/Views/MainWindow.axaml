<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaPlayer.ViewModels"
        xmlns:views="using:AvaPlayer.Views"
        xmlns:fi="using:FluentIcons.Avalonia"
        x:Class="AvaPlayer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Resources/logo.ico"
        Width="1020"
        Height="660"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Title="AvaPlayer"
        Background="{Binding PlayerBar.BackgroundBrush}">
  <Panel>
    <!-- Main content area -->
    <Grid Margin="0,32,0,0"
           ColumnDefinitions="50*,50*">
      <Border Grid.Column="0"
              Classes="player-panel">
        <views:PlayerBarView DataContext="{Binding PlayerBar}" />
      </Border>

      <Border Grid.Column="1"
              Classes="lyrics-panel">
        <views:LyricsView DataContext="{Binding Lyrics}" />
      </Border>

      <Border Grid.Column="1"
              Background="Transparent"
              IsHitTestVisible="{Binding PlayerBar.IsSettingsVisible}">
        <views:SettingsView DataContext="{Binding Settings}" />
      </Border>
    </Grid>

    <!-- Integrated titlebar row (UWP-style) -->
    <Border Height="32"
            VerticalAlignment="Top"
            Classes="titlebar"
            PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="40,Auto,*,40,46,46,46">
        <!-- Playlist / sidebar toggle -->
        <Button Grid.Column="0"
                Classes="titlebar-icon-button"
                Command="{Binding TogglePlaylistCommand}">
          <fi:FluentIcon Icon="AppsList" FontSize="16" />
        </Button>

        <!-- App title -->
        <TextBlock Grid.Column="1"
                   Text="AvaPlayer"
                   FontSize="13"
                   VerticalAlignment="Center"
                   Classes="player-title" />

        <!-- Settings toggle -->
        <Button Grid.Column="3"
                Classes="titlebar-icon-button"
                Command="{Binding PlayerBar.ToggleSettingsCommand}">
          <fi:FluentIcon Icon="{Binding PlayerBar.SettingsToggleIcon}" FontSize="16" />
        </Button>

        <!-- Minimize -->
        <Button Grid.Column="4"
                Classes="titlebar-button"
                Click="OnMinimizeClick">
          <fi:FluentIcon Icon="Subtract" FontSize="12" />
        </Button>

        <!-- Maximize / Restore -->
        <Button x:Name="MaximizeRestoreButton"
                Grid.Column="5"
                Classes="titlebar-button"
                Click="OnMaximizeRestoreClick">
          <fi:FluentIcon x:Name="MaximizeRestoreIcon"
                         Icon="FullScreenMaximize"
                         FontSize="12" />
        </Button>

        <!-- Close -->
        <Button Grid.Column="6"
                Classes="titlebar-button titlebar-close"
                Click="OnCloseClick">
          <fi:FluentIcon Icon="Dismiss" FontSize="12" />
        </Button>
      </Grid>
    </Border>

    <!-- Playlist drawer -->
    <Grid Classes="playlist-drawer-host"
          Classes.open="{Binding IsPlaylistVisible}">
      <Border Classes="playlist-drawer-scrim"
              Classes.open="{Binding IsPlaylistVisible}" />

      <Grid ColumnDefinitions="380,*">
        <Border Grid.Column="0"
                Classes="playlist-drawer-panel"
                Classes.open="{Binding IsPlaylistVisible}">
          <Grid RowDefinitions="Auto,*">
            <DockPanel Margin="16,16,16,12">
              <TextBlock Text="播放列表"
                         Classes="player-title"
                         FontSize="18"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <Button DockPanel.Dock="Right"
                      Classes="ghost"
                      Width="36" Height="36"
                      Command="{Binding ClosePlaylistCommand}">
                <fi:FluentIcon Icon="Dismiss" FontSize="16" />
              </Button>
            </DockPanel>

            <views:PlaylistView Grid.Row="1"
                                DataContext="{Binding Playlist}" />
          </Grid>
        </Border>

        <Border x:Name="OverlayDismissArea"
                Grid.Column="1"
                Background="Transparent"
                PointerPressed="OnOverlayDismissPointerPressed" />
      </Grid>
    </Grid>
  </Panel>
</Window>
