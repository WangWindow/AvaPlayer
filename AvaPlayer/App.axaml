<Application x:Class="AvaPlayer.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <Fluent2Theme />
    <StyleInclude Source="avares://AvaPlayer/Resources/Styles.axaml" />
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Clicked="OnPlayPauseClick"
                Icon="/Resources/logo-tray.png"
                ToolTipText="AvaPlayer">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Click="OnShowWindowClick" Header="显示窗口" />
            <NativeMenuItem Click="OnLightweightModeClick"
                            Header="轻量模式"
                            ToggleType="CheckBox" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Click="OnPreviousTrackClick" Header="上一首" />
            <NativeMenuItem Click="OnPlayPauseClick" Header="播放 / 暂停" />
            <NativeMenuItem Click="OnNextTrackClick" Header="下一首" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Click="OnExitClick" Header="退出" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
