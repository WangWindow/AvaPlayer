<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fi="using:FluentIcons.Avalonia">
  <Style Selector="Border.playlist-drawer-scrim">
    <Setter Property="Background" Value="{DynamicResource PlaylistDrawerScrimBackgroundBrush}" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ContentControl.playlist-reveal.open Border.playlist-drawer-scrim">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.playlist-drawer-panel">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BoxShadow" Value="0 14 40 0 #70000000" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransformOrigin" Value="0,0.5" />
    <Setter Property="RenderTransform" Value="translate(-36px, 0px)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.24" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ContentControl.playlist-reveal.open Border.playlist-drawer-panel">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
  </Style>
  <Style Selector="Button.playlist-item">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.playlist-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
  </Style>
  <Style Selector="Button.playlist-item.current">
    <Setter Property="Background" Value="{DynamicResource ControlAltFillColorQuarternaryBrush}" />
  </Style>
  <Style Selector="Button.playlist-item.current:pointerover">
    <Setter Property="Background" Value="{DynamicResource ControlAltFillColorQuarternaryBrush}" />
  </Style>
  <Style Selector="Button.playlist-item:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.playlist-item TextBlock.playlist-title">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.playlist-item TextBlock.playlist-subtitle">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.playlist-item TextBlock.playlist-duration">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.playlist-item.current TextBlock.playlist-subtitle">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style Selector="Button.playlist-item.current TextBlock.playlist-duration">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
  </Style>
  <Style Selector="ListBox.playlist-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.playlist-list ListBoxItem">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.playlist-list ListBoxItem:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.playlist-list ListBoxItem:selected">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBlock.playlist-toolbar-label">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.playlist-status-label">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="2,8,0,0" />
  </Style>
  <Style Selector="TextBlock.playlist-empty-text">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MaxWidth" Value="260" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="fi|FluentIcon.playlist-empty-icon">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
  </Style>
  <Style Selector="Border.playlist-search-bar">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="fi|FluentIcon.playlist-search-icon">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
  </Style>
</Styles>
