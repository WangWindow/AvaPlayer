[
  {
    "label": "Build",
    "command": "dotnet build AvaPlayer/AvaPlayer.csproj",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "no_focus"
  },
  {
    "label": "Build Release",
    "command": "dotnet build AvaPlayer/AvaPlayer.csproj -c Release",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "no_focus"
  },
  {
    "label": "Run",
    "command": "dotnet run --project AvaPlayer/AvaPlayer.csproj",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Test",
    "command": "dotnet test AvaPlayer.Tests/AvaPlayer.Tests.csproj",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },
  {
    "label": "Clean",
    "command": "dotnet clean",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "no_focus"
  }
]
