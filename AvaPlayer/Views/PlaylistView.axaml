<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaPlayer.ViewModels"
             xmlns:models="using:AvaPlayer.Models"
             xmlns:fi="using:FluentIcons.Avalonia"
             x:Name="Root"
             x:Class="AvaPlayer.Views.PlaylistView"
             x:DataType="vm:PlaylistViewModel">
  <UserControl.Resources>
    <x:Double x:Key="CheckBoxMinHeight">20</x:Double>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ListBox.playlist-list ListBoxItem">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="ListBox.playlist-list ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.playlist-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.playlist-list ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.playlist-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.playlist-list ListBoxItem:selected:not(:focus) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.playlist-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.playlist-list ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.playlist-item">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="CheckBox.playlist-select">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="20" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="CheckBox.playlist-select /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CheckBox.playlist-select:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="CheckBox.playlist-select:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="CheckBox.playlist-select:checked /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="CheckBox.playlist-select:checked:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="CheckBox.playlist-select:checked:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.playlist-toolbar-icon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="18" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*"
        Margin="16,0,16,16">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto"
          ColumnSpacing="8">
      <ComboBox Grid.Column="0"
                MinWidth="0"
                HorizontalAlignment="Stretch"
                IsVisible="{Binding ShowPlaylistSelector}"
                ItemsSource="{Binding Playlists}"
                SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="models:PlaylistInfo">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <TextBlock Text="{Binding Name}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding DisplayTrackCount}"
                         Classes="playlist-subtitle" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBox Grid.Column="0"
               PlaceholderText="歌单名称"
               Text="{Binding EditingPlaylistName, Mode=TwoWay}"
               IsVisible="{Binding IsRenamingPlaylist}" />

      <Button Grid.Column="1"
              Classes="ghost playlist-toolbar-icon"
              Command="{Binding AddPlaylistCommand}"
              ToolTip.Tip="添加歌单（选择一个音乐文件夹）">
        <fi:FluentIcon Icon="FolderAdd"
                       FontSize="16" />
      </Button>

      <Button Grid.Column="2"
              Classes="ghost playlist-toolbar-icon"
              Command="{Binding BeginRenamePlaylistCommand}"
              IsEnabled="{Binding HasSelectedPlaylist}"
              IsVisible="{Binding ShowPlaylistSelector}"
              ToolTip.Tip="重命名歌单">
        <fi:FluentIcon Icon="Edit"
                       FontSize="16" />
      </Button>

      <Button Grid.Column="3"
              Classes="ghost playlist-toolbar-icon"
              Command="{Binding DeletePlaylistCommand}"
              IsEnabled="{Binding HasSelectedPlaylist}"
              IsVisible="{Binding ShowPlaylistSelector}"
              ToolTip.Tip="删除当前歌单（仅移除索引，不删除磁盘文件）">
        <fi:FluentIcon Icon="Delete"
                       FontSize="16" />
      </Button>

      <Button Grid.Column="2"
              Classes="ghost"
              Height="36"
              Padding="12,8"
              Command="{Binding ConfirmRenamePlaylistCommand}"
              IsVisible="{Binding IsRenamingPlaylist}">
        <TextBlock Text="确定"
                   Classes="playlist-toolbar-label" />
      </Button>
    </Grid>

    <Grid Grid.Row="1"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="8"
          Margin="0,12,0,0">
      <Border Grid.Column="0"
              Classes="playlist-search-bar"
              Padding="12,0"
              IsVisible="{Binding ShowSearchBar}">
        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="8">
          <fi:FluentIcon Icon="Search"
                         Classes="playlist-search-icon"
                         FontSize="14"
                         VerticalAlignment="Center" />

          <TextBox Grid.Column="1"
                   Classes="playlist-search-text"
                   Background="Transparent"
                   BorderThickness="0"
                   PlaceholderText="搜索当前播放列表"
                   Text="{Binding SearchText, Mode=TwoWay}" />

          <Button Grid.Column="2"
                  Classes="ghost"
                  Width="28"
                  Height="28"
                  Padding="0"
                  Command="{Binding ClearSearchCommand}"
                  IsVisible="{Binding ShowClearSearch}">
            <fi:FluentIcon Icon="Dismiss"
                           FontSize="14" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="8">
        <Button Classes="ghost playlist-toolbar-icon"
                Command="{Binding BeginEditCommand}"
                IsVisible="{Binding ShowSearchBar}"
                ToolTip.Tip="编辑播放列表">
          <fi:FluentIcon Icon="Edit"
                         FontSize="16" />
        </Button>

        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    IsVisible="{Binding ShowEditToolbar}">
          <Button Classes="ghost"
                  Height="36"
                  Padding="12,8"
                  Command="{Binding RemoveSelectedCommand}"
                  IsEnabled="{Binding CanRemoveSelected}">
            <TextBlock Text="删除"
                       Classes="playlist-toolbar-label" />
          </Button>
          <Button Classes="ghost"
                  Height="36"
                  Padding="12,8"
                  Command="{Binding CancelEditCommand}">
            <TextBlock Text="取消"
                       Classes="playlist-toolbar-label" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2"
          Margin="0,12,0,0">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="12"
                  IsVisible="{Binding ShowEmptyState}">
        <fi:FluentIcon Icon="MusicNote2"
                       FontSize="44"
                       Foreground="#55FFFFFF"
                       HorizontalAlignment="Center" />
        <TextBlock Text="{Binding EmptyStateText}"
                   Foreground="#75FFFFFF"
                   FontSize="14"
                   HorizontalAlignment="Center" />
      </StackPanel>

      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="12"
                  IsVisible="{Binding ShowSearchEmptyState}">
        <fi:FluentIcon Icon="Search"
                       FontSize="40"
                       Foreground="#55FFFFFF"
                       HorizontalAlignment="Center" />
        <TextBlock Text="{Binding SearchEmptyStateText}"
                   Foreground="#75FFFFFF"
                   FontSize="14"
                   HorizontalAlignment="Center" />
      </StackPanel>

      <ListBox IsVisible="{Binding HasVisibleTracks}"
               Classes="playlist-list"
               ItemsSource="{Binding VisibleTracks}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TrackItemViewModel">
            <Button Classes="playlist-item"
                    Classes.current="{Binding IsCurrent}"
                    Command="{Binding #Root((vm:PlaylistViewModel)DataContext).SelectTrackCommand}"
                    CommandParameter="{Binding}">
              <Grid ColumnDefinitions="32,*,Auto"
                    ColumnSpacing="12">
                <Grid Grid.Column="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                  <CheckBox Classes="playlist-select"
                            IsVisible="{Binding #Root((vm:PlaylistViewModel)DataContext).ShowEditToolbar}"
                            IsChecked="{Binding IsSelectedForRemoval, Mode=TwoWay}" />

                  <Grid IsVisible="{Binding #Root((vm:PlaylistViewModel)DataContext).ShowNormalToolbar}">
                    <fi:FluentIcon Icon="Play"
                                   FontSize="14"
                                   Foreground="White"
                                   IsVisible="{Binding ShowCurrentGlyph}" />

                    <fi:FluentIcon Icon="MusicNote2"
                                   FontSize="16"
                                   Foreground="#8CFFFFFF"
                                   IsVisible="{Binding ShowIdleGlyph}" />
                  </Grid>
                </Grid>

                <StackPanel Grid.Column="1"
                            Spacing="4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                  <TextBlock Classes="playlist-title"
                             Text="{Binding Title}"
                             MaxWidth="220"
                             TextAlignment="Left"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="playlist-subtitle"
                             Text="{Binding Artist}"
                             MaxWidth="220"
                             TextAlignment="Left"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Classes="playlist-duration"
                           Text="{Binding DurationText}"
                           VerticalAlignment="Center"
                           TextAlignment="Right" />
              </Grid>
            </Button>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
