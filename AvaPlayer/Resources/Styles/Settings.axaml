<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.settings-panel">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.settings-group">
    <Setter Property="Background" Value="{DynamicResource SettingsGroupBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,2" />
  </Style>
  <Style Selector="Grid.settings-row">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Margin" Value="0,4" />
  </Style>
  <Style Selector="Border.settings-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBorderBrush}" />
  </Style>
  <Style Selector="TextBlock.settings-group-label">
    <Setter Property="Foreground" Value="{DynamicResource PlayerMutedForegroundBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="12,8,0,0" />
  </Style>
  <Style Selector="TextBlock.settings-label">
    <Setter Property="Foreground" Value="{DynamicResource PlayerForegroundBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.settings-title">
    <Setter Property="Foreground" Value="{DynamicResource PlayerForegroundBrush}" />
  </Style>
  <Style Selector="TextBlock.settings-description">
    <Setter Property="Foreground" Value="{DynamicResource PlayerMutedForegroundBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ToggleSwitch.settings-switch">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource PlayerForegroundBrush}" />
  </Style>
  <Style Selector="Button.settings-chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource PlayerForegroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.settings-chip:pointerover">
    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}" />
  </Style>
  <Style Selector="Button.settings-chip.selected">
    <Setter Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
  </Style>
  <Style Selector="Button.settings-chip:pressed">
    <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
  </Style>
  <Style Selector="Button.settings-chip:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
</Styles>
