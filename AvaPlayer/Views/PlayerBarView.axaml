<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaPlayer.ViewModels"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:views="using:AvaPlayer.Views"
             x:Name="Root"
             x:Class="AvaPlayer.Views.PlayerBarView"
             x:DataType="vm:PlayerBarViewModel">
  <Grid x:Name="PlaybackRoot" Margin="24,16">
    <Grid x:Name="PlaybackContent">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <!-- Cover art -->
      <Border x:Name="CoverBorder" Grid.Row="1"
              Width="{Binding CoverSize}"
              Height="{Binding CoverSize}"
              HorizontalAlignment="Center"
              CornerRadius="18"
              ClipToBounds="True"
              BoxShadow="0 12 36 0 #50000000">
        <Grid>
          <Border Background="{DynamicResource SearchBackgroundBrush}"
                  IsVisible="{Binding ShowAlbumArtPlaceholder}" />
          <fi:FluentIcon Icon="MusicNote2"
                         FontSize="72"
                         Foreground="{DynamicResource PlayerMutedForegroundBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsVisible="{Binding ShowAlbumArtPlaceholder}" />
          <Image Source="{Binding AlbumArtBitmap}"
                 Stretch="UniformToFill"
                 IsVisible="{Binding HasAlbumArt}" />
        </Grid>
      </Border>
      <!-- Title & Artist -->
      <StackPanel x:Name="TrackDetails" Grid.Row="2"
                  Spacing="8"
                  HorizontalAlignment="Center"
                  MaxWidth="400"
                  Margin="0,24,0,0">
        <TextBlock Classes="player-title" Text="{Binding TitleDisplay}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="ArtistText" Text="{Binding ArtistDisplay}"
                   Classes="player-subtitle"
                   FontSize="13"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
      <!-- Progress bar -->
      <Grid x:Name="ProgressGrid" Grid.Row="3"
            MaxWidth="360"
            HorizontalAlignment="Stretch"
            ColumnDefinitions="Auto,*,Auto"
            Margin="0,16,0,0">
        <TextBlock Grid.Column="0"
                   Text="{Binding PositionText}"
                   Classes="player-time"
                   FontSize="12"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center" />
        <Slider x:Name="ProgressSlider" Classes="white"
                Grid.Column="1"
                Minimum="0"
                Maximum="{Binding Duration}"
                Value="{Binding Position, Mode=TwoWay}" />
        <TextBlock Grid.Column="2"
                   Text="{Binding DurationText}"
                   Classes="player-time"
                   FontSize="12"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center" />
      </Grid>
      <!-- Playback controls -->
      <Grid x:Name="ControlGrid" Grid.Row="4"
            Width="292"
            HorizontalAlignment="Center"
            Margin="0,12,0,0">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="10">
          <Button Classes="ghost"
                  Width="40" Height="40"
                  ToolTip.Tip="{Binding PlaybackModeTooltip}"
                  Command="{Binding TogglePlaybackModeCommand}">
            <fi:FluentIcon Icon="{Binding PlaybackModeIcon}" FontSize="18" />
          </Button>
          <Button Classes="ghost"
                  Width="40" Height="40"
                  ToolTip.Tip="上一首（Ctrl+←）" AutomationProperties.Name="上一首"
                  Command="{Binding PreviousCommand}">
            <fi:FluentIcon Icon="Previous" FontSize="18" />
          </Button>
          <Button Classes="ghost-large"
                  ToolTip.Tip="播放 / 暂停（Ctrl+P）" AutomationProperties.Name="播放 / 暂停"
                  Command="{Binding PlayPauseCommand}">
            <fi:FluentIcon Icon="{Binding PlayPauseIcon}" FontSize="24" />
          </Button>
          <Button Classes="ghost"
                  Width="40" Height="40"
                  ToolTip.Tip="下一首（Ctrl+→）" AutomationProperties.Name="下一首"
                  Command="{Binding NextCommand}">
            <fi:FluentIcon Icon="Next" FontSize="18" />
          </Button>
          <Button x:Name="VolumeButton" Classes="ghost" Width="40" Height="40"
                  ToolTip.Tip="音量" AutomationProperties.Name="音量" Click="OnVolumeButtonClick">
            <fi:FluentIcon Icon="{Binding VolumeIcon}" FontSize="18" />
          </Button>
        </StackPanel>
      </Grid>
      <!-- The volume reveal uses the lower spacer, outside the centered playback group. -->
      <views:RevealPresenter x:Name="VolumeInlinePanel" Classes="volume-inline-host" Grid.Row="5"
                             TransitionDuration="0:0:0.22" Width="292" HorizontalAlignment="Center"
                             HorizontalContentAlignment="Stretch" VerticalAlignment="Top" ClipToBounds="True">
        <Grid Margin="16,18,16,8" ColumnDefinitions="38,*,38" ColumnSpacing="14" Height="24">
          <fi:FluentIcon Icon="{Binding VolumeIcon}" Foreground="{DynamicResource PlayerForegroundBrush}"
                         FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Slider x:Name="VolumeSlider" Grid.Column="1" Classes="white" Height="24" MinHeight="0" Minimum="0" Maximum="100"
                  Value="{Binding Volume, Mode=TwoWay}" AutomationProperties.Name="音量" />
          <TextBlock Grid.Column="2" Classes="volume-text" Text="{Binding VolumeText}" FontSize="12"
                     TextAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </views:RevealPresenter>
    </Grid>
  </Grid>
</UserControl>
