<Window x:Class="AvaPlayer.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fi="using:FluentIcons.Avalonia"
        xmlns:views="using:AvaPlayer.Views"
        xmlns:vm="using:AvaPlayer.ViewModels"
        Title="AvaPlayer"
        Width="1020"
        Height="660"
        MinWidth="720"
        MinHeight="480"
        x:DataType="vm:MainWindowViewModel"
        Background="Transparent"
        Icon="/Resources/logo.ico"
        TransparencyBackgroundFallback="{DynamicResource SystemControlBackgroundAltHighBrush}"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen">
  <Border x:Name="WindowSurface"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          ClipToBounds="True">
    <Panel>
      <Border Background="{Binding PlayerBar.BackgroundBrush}"
              Classes="player-backdrop"
              IsHitTestVisible="False" />
      <!--  Main content area  -->
      <Grid Margin="0,32,0,0" ColumnDefinitions="50*,50*">
        <Border x:Name="PlayerPanel" Grid.Column="0">
          <views:PlayerBarView DataContext="{Binding PlayerBar}" />
        </Border>

        <Border x:Name="LyricsPanel"
                Grid.Column="1"
                Classes="lyrics-panel"
                IsVisible="{Binding !#SettingsReveal.IsVisible}">
          <views:LyricsView DataContext="{Binding Lyrics}" />
        </Border>

        <views:RevealPresenter x:Name="SettingsReveal"
                               Grid.Column="1"
                               Classes="settings-stage"
                               IsOpen="{Binding PlayerBar.IsSettingsVisible}"
                               TransitionDuration="0:0:0.24">
          <views:SettingsView DataContext="{Binding Settings}" />
        </views:RevealPresenter>
      </Grid>

      <!--  Integrated titlebar row (UWP-style)  -->
      <Border Height="32"
              VerticalAlignment="Top"
              Classes="titlebar"
              PointerPressed="OnTitleBarPointerPressed">
        <Grid ColumnDefinitions="40,Auto,*,40,46,46,46">
          <!--  Playlist / sidebar toggle  -->
          <Button x:Name="PlaylistToggle"
                  Grid.Column="0"
                  AutomationProperties.Name="歌单"
                  Classes="titlebar-icon-button"
                  Command="{Binding TogglePlaylistCommand}"
                  ToolTip.Tip="歌单">
            <fi:FluentIcon FontSize="16" Icon="AppsList" />
          </Button>

          <!--  App title  -->
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     Classes="player-title"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Text="AvaPlayer" />

          <!--  Settings toggle  -->
          <Button x:Name="SettingsToggle"
                  Grid.Column="3"
                  AutomationProperties.Name="{Binding PlayerBar.SettingsToggleToolTip}"
                  Classes="titlebar-icon-button"
                  Command="{Binding PlayerBar.ToggleSettingsCommand}"
                  ToolTip.Tip="{Binding PlayerBar.SettingsToggleToolTip}">
            <fi:FluentIcon FontSize="16" Icon="{Binding PlayerBar.SettingsToggleIcon}" />
          </Button>

          <!--  Minimize  -->
          <Button Grid.Column="4"
                  AutomationProperties.Name="最小化"
                  Classes="titlebar-button"
                  Click="OnMinimizeClick"
                  ToolTip.Tip="最小化">
            <fi:FluentIcon FontSize="12" Icon="Subtract" />
          </Button>

          <!--  Maximize / Restore  -->
          <Button x:Name="MaximizeRestoreButton"
                  Grid.Column="5"
                  AutomationProperties.Name="最大化 / 还原"
                  Classes="titlebar-button"
                  Click="OnMaximizeRestoreClick"
                  ToolTip.Tip="最大化 / 还原">
            <fi:FluentIcon x:Name="MaximizeRestoreIcon"
                           FontSize="12"
                           Icon="FullScreenMaximize" />
          </Button>

          <!--  Close  -->
          <Button Grid.Column="6"
                  AutomationProperties.Name="关闭"
                  Classes="titlebar-button titlebar-close"
                  Click="OnCloseClick"
                  ToolTip.Tip="关闭">
            <fi:FluentIcon FontSize="12" Icon="Dismiss" />
          </Button>
        </Grid>
      </Border>

      <!--  Playlist drawer  -->
      <views:RevealPresenter x:Name="PlaylistReveal"
                             Margin="0,32,0,0"
                             Classes="playlist-reveal"
                             IsOpen="{Binding IsPlaylistVisible}">
        <Grid>
          <Border Classes="playlist-drawer-scrim" />

          <Grid ColumnDefinitions="380,*">
            <Border x:Name="PlaylistDrawer"
                    Grid.Column="0"
                    Classes="playlist-drawer-panel">
              <Grid>
                <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
                <Border Background="{Binding PlayerBar.BackgroundBrush}"
                        Opacity="{DynamicResource PlayerBackdropOpacity}" />
                <Border Background="{DynamicResource PlaylistDrawerTintBrush}" />
                <Grid RowDefinitions="Auto,*">
                <DockPanel Margin="16,16,16,12">
                  <TextBlock VerticalAlignment="Center"
                             Classes="player-title"
                             FontSize="18"
                             FontWeight="SemiBold"
                             Text="播放列表" />
                </DockPanel>

                <views:PlaylistView x:Name="LibraryContent"
                                    Grid.Row="1"
                                    DataContext="{Binding Playlist}" />
                </Grid>
              </Grid>
            </Border>

            <Border x:Name="OverlayDismissArea"
                    Grid.Column="1"
                    Background="Transparent"
                    PointerPressed="OnOverlayDismissPointerPressed" />
          </Grid>
        </Grid>
      </views:RevealPresenter>

      <Grid x:Name="ResizeGrips" IsHitTestVisible="True">
        <Border Height="5"
                Margin="8,0"
                VerticalAlignment="Top"
                Background="Transparent"
                Cursor="TopSide"
                PointerPressed="OnResizeGripPointerPressed"
                Tag="North" />
        <Border Height="5"
                Margin="8,0"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Cursor="BottomSide"
                PointerPressed="OnResizeGripPointerPressed"
                Tag="South" />
        <Border Width="5"
                Margin="0,8"
                HorizontalAlignment="Left"
                Background="Transparent"
                Cursor="LeftSide"
                PointerPressed="OnResizeGripPointerPressed"
                Tag="West" />
        <Border Width="5"
                Margin="0,8"
                HorizontalAlignment="Right"
                Background="Transparent"
                Cursor="RightSide"
                PointerPressed="OnResizeGripPointerPressed"
                Tag="East" />
        <Border Width="8"
                Height="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Transparent"
                Cursor="TopLeftCorner"
                PointerPressed="OnResizeGripPointerPressed"
                Tag="NorthWest" />
        <Border Width="8"
                Height="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="Transparent"
                Cursor="TopRightCorner"
                PointerPressed="OnResizeGripPointerPressed"
                Tag="NorthEast" />
        <Border Width="8"
                Height="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Cursor="BottomLeftCorner"
                PointerPressed="OnResizeGripPointerPressed"
                Tag="SouthWest" />
        <Border Width="8"
                Height="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Cursor="BottomRightCorner"
                PointerPressed="OnResizeGripPointerPressed"
                Tag="SouthEast" />
      </Grid>
    </Panel>
  </Border>
</Window>
