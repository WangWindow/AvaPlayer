<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fi="using:FluentIcons.Avalonia">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="SettingsGroupBackgroundBrush" Color="#12FFFFFF" />
          <SolidColorBrush x:Key="PlayerForegroundBrush" Color="White" />
          <SolidColorBrush x:Key="ControlHoverBrush" Color="#30FFFFFF" />
          <SolidColorBrush x:Key="ControlPressedBrush" Color="#50FFFFFF" />
          <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#30FFFFFF" />
          <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#45FFFFFF" />
          <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#60FFFFFF" />
          <SolidColorBrush x:Key="PlaylistDrawerScrimBackgroundBrush" Color="#55000000" />
          <SolidColorBrush x:Key="PlaylistDrawerPanelBackgroundBrush" Color="#FA140E1E" />
          <SolidColorBrush x:Key="ItemHoverBrush" Color="#18FFFFFF" />
          <SolidColorBrush x:Key="ItemSelectedBrush" Color="#30FFFFFF" />
          <SolidColorBrush x:Key="ItemSelectedHoverBrush" Color="#3AFFFFFF" />
          <SolidColorBrush x:Key="TrackSubtitleBrush" Color="#99FFFFFF" />
          <SolidColorBrush x:Key="PlayerMutedForegroundBrush" Color="#8CFFFFFF" />
          <SolidColorBrush x:Key="CurrentTrackSubtitleBrush" Color="#CCFFFFFF" />
          <SolidColorBrush x:Key="CurrentTrackDurationBrush" Color="#E6FFFFFF" />
          <SolidColorBrush x:Key="SearchBackgroundBrush" Color="#10FFFFFF" />
          <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#24FFFFFF" />
          <SolidColorBrush x:Key="ImmersiveMenuBackgroundBrush" Color="#B214101D" />
          <SolidColorBrush x:Key="MenuForegroundBrush" Color="#F2FFFFFF" />
          <SolidColorBrush x:Key="MenuOpenBrush" Color="#20FFFFFF" />
          <SolidColorBrush x:Key="LyricLineButtonPressedBackgroundBrush" Color="#18FFFFFF" />
          <SolidColorBrush x:Key="LyricActiveBackgroundBrush" Color="#08FFFFFF" />
          <SolidColorBrush x:Key="SliderTrackBrush" Color="#35FFFFFF" />
          <SolidColorBrush x:Key="PlayerSecondaryForegroundBrush" Color="#B3FFFFFF" />
          <SolidColorBrush x:Key="PlayerTimeForegroundBrush" Color="#A6FFFFFF" />
          <SolidColorBrush x:Key="LyricsStatusForegroundBrush" Color="#80FFFFFF" />
          <SolidColorBrush x:Key="LyricsEmptyForegroundBrush" Color="#66FFFFFF" />
          <SolidColorBrush x:Key="TitlebarBackgroundBrush" Color="#C014101D" />
          <SolidColorBrush x:Key="TitlebarButtonHoverBrush" Color="#26FFFFFF" />
          <SolidColorBrush x:Key="TitlebarButtonPressedBrush" Color="#40FFFFFF" />
          <x:Double x:Key="PlayerBackdropOpacity">1</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SettingsGroupBackgroundBrush" Color="#B3FFFFFF" />
          <SolidColorBrush x:Key="PlayerForegroundBrush" Color="#1A1A1A" />
          <SolidColorBrush x:Key="ControlHoverBrush" Color="#12000000" />
          <SolidColorBrush x:Key="ControlPressedBrush" Color="#1E000000" />
          <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#14000000" />
          <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#1E000000" />
          <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#2A000000" />
          <SolidColorBrush x:Key="PlaylistDrawerScrimBackgroundBrush" Color="#40000000" />
          <SolidColorBrush x:Key="PlaylistDrawerPanelBackgroundBrush" Color="#F4F1F0F8" />
          <SolidColorBrush x:Key="ItemHoverBrush" Color="#0C000000" />
          <SolidColorBrush x:Key="ItemSelectedBrush" Color="#18000000" />
          <SolidColorBrush x:Key="ItemSelectedHoverBrush" Color="#20000000" />
          <SolidColorBrush x:Key="TrackSubtitleBrush" Color="#66000000" />
          <SolidColorBrush x:Key="PlayerMutedForegroundBrush" Color="#55000000" />
          <SolidColorBrush x:Key="CurrentTrackSubtitleBrush" Color="#88000000" />
          <SolidColorBrush x:Key="CurrentTrackDurationBrush" Color="#77000000" />
          <SolidColorBrush x:Key="SearchBackgroundBrush" Color="#08000000" />
          <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#18000000" />
          <SolidColorBrush x:Key="ImmersiveMenuBackgroundBrush" Color="#F4F1F0F8" />
          <SolidColorBrush x:Key="MenuForegroundBrush" Color="#1A1A1A" />
          <SolidColorBrush x:Key="MenuOpenBrush" Color="#12000000" />
          <SolidColorBrush x:Key="LyricLineButtonPressedBackgroundBrush" Color="#0E000000" />
          <SolidColorBrush x:Key="LyricActiveBackgroundBrush" Color="#06000000" />
          <SolidColorBrush x:Key="SliderTrackBrush" Color="#20000000" />
          <SolidColorBrush x:Key="PlayerSecondaryForegroundBrush" Color="#66000000" />
          <SolidColorBrush x:Key="PlayerTimeForegroundBrush" Color="#55000000" />
          <SolidColorBrush x:Key="LyricsStatusForegroundBrush" Color="#55000000" />
          <SolidColorBrush x:Key="LyricsEmptyForegroundBrush" Color="#40000000" />
          <SolidColorBrush x:Key="TitlebarBackgroundBrush" Color="#E0F4F1F0" />
          <SolidColorBrush x:Key="TitlebarButtonHoverBrush" Color="#12000000" />
          <SolidColorBrush x:Key="TitlebarButtonPressedBrush" Color="#1E000000" />
          <x:Double x:Key="PlayerBackdropOpacity">0.12</x:Double>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <StyleInclude Source="/Resources/Styles/Controls.axaml" />
  <StyleInclude Source="/Resources/Styles/Window.axaml" />
  <StyleInclude Source="/Resources/Styles/Library.axaml" />
  <StyleInclude Source="/Resources/Styles/Lyrics.axaml" />
  <StyleInclude Source="/Resources/Styles/Settings.axaml" />
</Styles>
