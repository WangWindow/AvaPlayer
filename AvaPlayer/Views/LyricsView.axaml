<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaPlayer.ViewModels"
             x:Name="Root"
             x:Class="AvaPlayer.Views.LyricsView"
             x:DataType="vm:LyricsViewModel">
  <Grid Margin="24,32">
    <TextBlock Classes="lyrics-status" Text="加载歌词中..."
               FontSize="14"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsVisible="{Binding IsLoading}" />
    <TextBlock Classes="lyrics-empty" Text="暂无歌词"
               FontSize="14"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsVisible="{Binding ShowEmptyState}" />
    <ScrollViewer x:Name="LyricsScroller"
                  IsVisible="{Binding HasLyrics}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden">
      <StackPanel>
        <Border x:Name="TopSpacer" />
        <ItemsControl x:Name="LyricsItems"
                      ItemsSource="{Binding Lines}"
                      MaxWidth="560"
                      HorizontalAlignment="Stretch">
          <ItemsControl.Styles>
            <Style Selector="ContentPresenter">
              <Setter Property="HorizontalAlignment" Value="Stretch" />
              <Setter Property="ClipToBounds" Value="False" />
            </Style>
          </ItemsControl.Styles>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LyricLineViewModel">
              <Button Classes="lyric-line-button"
                      Classes.active="{Binding IsCurrent}"
                      Classes.near="{Binding IsNearCurrent}"
                      Command="{Binding #Root((vm:LyricsViewModel)DataContext).SeekToLineCommand}"
                      CommandParameter="{Binding}"
                      HorizontalAlignment="Stretch"
                      ClipToBounds="False">
                <TextBlock Text="{Binding Text}"
                           FontSize="{Binding DisplayFontSize}"
                           Opacity="{Binding DisplayOpacity}"
                           Classes="lyric-line"
                           Classes.active="{Binding IsCurrent}"
                           Classes.near="{Binding IsNearCurrent}" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border x:Name="BottomSpacer" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
